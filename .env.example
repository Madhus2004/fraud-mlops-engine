# Shared by Render (serving) AND your local worker -> both hit the same Postgres
DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require
# Model registry (Hugging Face Hub model repo)
HF_REPO_ID=your-username/fraud-engine-models
HF_TOKEN=hf_xxx            # write token: local worker only. Render can use a read-only token.
# Hot reload
API_URL=https://your-service.onrender.com
ADMIN_TOKEN=change-me
# Optional
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
